/* ════════════════════════════════════════════════════════════════════════════════
   StudyMate AI — AI Core Theme
   Deep Space · Electric Indigo · Neon Purple · Soft Pink · Cyan Glow
   Dark Glassmorphism + 3D Neural Animation
   ════════════════════════════════════════════════════════════════════════════════ */

:root{

  /* Cosmic Backgrounds */
  --bg:#050816;
  --bg-secondary:#0D1438;
  --bg2:#0D1438;
  --bg3:#131B4D;

  /* Glass & Cards */
  --card:rgba(255,255,255,.08);
  --card-hover:rgba(255,255,255,.14);
  --glass:rgba(255,255,255,.08);
  --glass-strong:rgba(255,255,255,.15);

  /* Brand Colors */
  --primary:#3D2EFF;        /* Electric Indigo */
  --primary-dark:#2A1FCC;
  --secondary:#7B3FFF;      /* Neon Purple */
  --accent:#40E8FF;         /* Cyan Glow */
  --pink:#FF5FD7;           /* Soft Pink */
  --green:#74FF9C;          /* AI Green */

  /* Text */
  --text:#EAF0FF;
  --text2:#8B9BD1;
  --text3:#B4C1EE;
  --text-light:#8B9BD1;

  /* Borders */
  --border:rgba(255,255,255,.15);
  --border2:rgba(61,46,255,.35);

  /* Status */
  --success:#74FF9C;
  --warning:#F5C542;
  --danger:#FF5C7A;

  /* Gradients */
  --grad:linear-gradient(135deg, #7B3FFF 0%, #FF5FD7 50%, #40E8FF 100%);
  --gradient:linear-gradient(135deg, #7B3FFF 0%, #FF5FD7 50%, #40E8FF 100%);
  --grad-pink:linear-gradient(135deg, #7B3FFF 0%, #FF5FD7 100%);
  --grad2:linear-gradient(135deg, rgba(123,63,255,.20), rgba(64,232,255,.15));
  --grad3:linear-gradient(135deg, rgba(255,95,215,.20), rgba(116,255,156,.15));
  --grad-accent:linear-gradient(135deg, #40E8FF, #74FF9C);
  --grad-bg:linear-gradient(180deg, #050816 0%, #0D1438 40%, #170B3D 70%, #050816 100%);

  /* Glows / Shadows */
  --shadow:0 10px 30px rgba(5,8,22,.65);
  --shadow-lg:0 20px 60px rgba(5,8,22,.80);
  --shadow-glow:0 0 30px rgba(123,63,255,.45);
  --shadow-glow-lg:0 0 55px rgba(64,232,255,.50);
  --glow-primary:rgba(123,63,255,.6);
  --glow-pink:rgba(255,95,215,.5);
  --glow-cyan:rgba(64,232,255,.5);

  /* Radius */
  --r:16px;
  --r2:14px;
  --r3:24px;

  /* Layout */
  --sidebar:260px;

  /* Fonts */
  --font:'Inter',sans-serif;
  --font-heading:'Space Grotesk',sans-serif;
}

*{ box-sizing:border-box; }

body{
  margin:0;
  min-height:100vh;
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
  position:relative;
  font-family:var(--font);
}

/* ── Dark Cosmic Aurora Backdrop (Zero Neural Lines) ── */
body::before{
  content:"";
  position:fixed;
  inset:0;
  z-index:-2;
  pointer-events:none;
  background:
    radial-gradient(circle at 15% 20%, rgba(123,63,255,.40), transparent 35%),
    radial-gradient(circle at 85% 25%, rgba(64,232,255,.35), transparent 35%),
    radial-gradient(circle at 70% 80%, rgba(255,95,215,.30), transparent 38%),
    radial-gradient(circle at 25% 75%, rgba(116,255,156,.20), transparent 35%),
    var(--grad-bg);
  filter:blur(80px);
  animation:aurora 20s ease-in-out infinite alternate;
}

body::after{
  content:"";
  position:fixed;
  inset:0;
  z-index:-1;
  pointer-events:none;
  background-image:
    radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,.6), transparent),
    radial-gradient(1px 1px at 70% 60%, rgba(255,255,255,.5), transparent),
    radial-gradient(1px 1px at 40% 80%, rgba(255,255,255,.4), transparent),
    radial-gradient(1px 1px at 90% 15%, rgba(255,255,255,.5), transparent),
    radial-gradient(1px 1px at 55% 45%, rgba(255,255,255,.35), transparent);
  background-size:600px 600px;
  opacity:.5;
}

@keyframes aurora{
  0%{ transform:scale(1) rotate(0deg); }
  100%{ transform:scale(1.15) rotate(12deg); }
}

/* ── Typography ── */
a{ color:var(--accent); text-decoration:none; transition:all .25s; position:relative; }
a:hover{ color:var(--pink); }
h1,h2,h3,h4,h5,h6{ font-family:var(--font-heading); color:#FFFFFF !important; font-weight:700; letter-spacing:-0.03em; }
h1{ font-size:clamp(2.2rem, 5vw, 3.8rem); font-weight:800; }
h2{ font-size:1.8rem; }
h3{ font-size:1.25rem; }

/* ── Fixed Glassmorphism Navigation Bar ── */
.landing-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 48px;
  width: 100%;
  background: rgba(5, 8, 22, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
}

.logo-brain-icon {
  width: 36px;
  height: 36px;
  background: rgba(123, 63, 255, 0.2);
  border: 1.5px solid rgba(64, 232, 255, 0.5);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  box-shadow: 0 0 20px rgba(64, 232, 255, 0.3);
}

.logo-text {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: #FFFFFF !important;
}

.logo-ai-gradient {
  color: #FFFFFF !important;
  background: none !important;
  -webkit-text-fill-color: initial !important;
}

.nav-menu {
  display: flex;
  gap: 32px;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
}
.nav-menu a {
  color: #C8D0E8;
  font-weight: 500;
  font-size: 0.95rem;
  transition: all .25s;
  padding-bottom: 4px;
}
.nav-menu a:hover {
  color: #FFFFFF;
}
.nav-menu a.active {
  color: #FFFFFF;
  font-weight: 600;
  position: relative;
}
.nav-menu a.active::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  right: 0;
  height: 2px;
  background: #40E8FF;
  border-radius: 2px;
  box-shadow: 0 0 10px rgba(64,232,255,0.8);
}

.nav-actions {
  display: flex;
  gap: 14px;
  align-items: center;
}

.btn-login-pill {
  padding: 10px 24px;
  border-radius: 50px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF !important;
  font-weight: 600;
  font-size: 0.92rem;
  transition: all 0.3s;
}
.btn-login-pill:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: var(--accent);
  color: #FFFFFF !important;
}

.btn-gradient-pill {
  padding: 10px 26px;
  border-radius: 50px;
  background: linear-gradient(135deg, #7B3FFF 0%, #FF5FD7 100%);
  color: #FFFFFF !important;
  font-weight: 700;
  font-size: 0.92rem;
  border: none;
  box-shadow: 0 0 24px rgba(255, 95, 215, 0.45);
  transition: all 0.3s;
}
.btn-gradient-pill:hover {
  transform: scale(1.05);
  box-shadow: 0 0 35px rgba(255, 95, 215, 0.65), 0 0 25px rgba(64, 232, 255, 0.4);
}

/* ── Hero Section (100vh Visibility) ── */
.landing {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 10;
  overflow-x: hidden;
  margin: 0;
  padding: 0;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 100px 48px 40px;
  max-width: 1350px;
  margin: 0 auto;
  width: 100%;
  min-height: 100vh;
  position: relative;
  z-index: 30;
  box-sizing: border-box;
}

.hero-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  flex: 1;
}

.hero-content {
  max-width: 580px;
  text-align: left;
}

.hero-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 18px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 50px;
  font-size: 0.84rem;
  color: #C8D0E8;
  font-weight: 600;
  margin-bottom: 22px;
  backdrop-filter: blur(12px);
  box-shadow: 0 0 20px rgba(123, 63, 255, 0.2);
}

.hero h1 {
  font-size: clamp(2.6rem, 5.2vw, 4.2rem);
  font-weight: 800;
  line-height: 1.12;
  margin-top: 0;
  margin-bottom: 20px;
  color: #FFFFFF !important;
  background: none !important;
  -webkit-text-fill-color: initial !important;
  letter-spacing: -0.03em;
}

.hero p {
  font-size: 1.08rem;
  color: #AEB8D8;
  margin-top: 0;
  margin-bottom: 32px;
  max-width: 520px;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  gap: 14px;
  align-items: center;
  flex-wrap: wrap;
}

.btn-hero-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 30px;
  border-radius: 50px;
  background: linear-gradient(135deg, #7B3FFF 0%, #FF5FD7 100%);
  color: #FFFFFF !important;
  font-weight: 700;
  font-size: 1rem;
  border: none;
  box-shadow: 0 0 28px rgba(255, 95, 215, 0.5);
  transition: all 0.3s;
}
.btn-hero-primary:hover {
  transform: translateY(-2px) scale(1.04);
  box-shadow: 0 0 40px rgba(255, 95, 215, 0.7);
}

.btn-hero-secondary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 28px;
  border-radius: 50px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF !important;
  font-weight: 600;
  font-size: 0.98rem;
  transition: all 0.3s;
}
.btn-hero-secondary:hover {
  background: rgba(255, 255, 255, 0.14);
  border-color: var(--accent);
  color: #FFFFFF !important;
}

.feature-chips-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 32px;
}

.chip-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 50px;
  font-size: 0.85rem;
  color: #C8D0E8;
  font-weight: 500;
  backdrop-filter: blur(10px);
  transition: all 0.3s;
}

/* ── 5 Premium Glass Feature Cards ── */
.features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
  max-width: 1350px;
  margin: 0 auto;
  padding: 60px 48px 100px;
  position: relative;
  z-index: 30;
}

.feature-card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 24px;
  padding: 32px 24px;
  text-align: left;
  transition: all 0.35s cubic-bezier(.4, 0, .2, 1);
  box-shadow: 0 10px 30px rgba(5, 8, 22, 0.5);
  position: relative;
  overflow: hidden;
}

.feature-card:hover {
  transform: translateY(-8px);
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--accent);
  box-shadow: 0 20px 50px rgba(5, 8, 22, 0.7), 0 0 30px rgba(64, 232, 255, 0.3);
}

.feature-icon {
  font-size: 2.2rem;
  margin-bottom: 16px;
}

/* ════════════════════════════════════════════════════════════════════════════════
   Desktop SaaS Dashboard Layout (Left Sidebar 260px + Right Content Grid)
   ════════════════════════════════════════════════════════════════════════════════ */

.app-layout {
  display: flex;
  min-height: 100vh;
  width: 100%;
  position: relative;
}

/* 1. Left Sidebar (260px Width) */
.sidebar {
  width: 260px;
  min-width: 260px;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: rgba(13, 20, 56, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-right: 1px solid rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 28px;
}

.sidebar-logo .logo-icon {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  background: rgba(123, 63, 255, 0.25);
  border: 1px solid rgba(64, 232, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.nav-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-links li a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: 12px;
  color: #C8D0E8;
  font-weight: 500;
  font-size: 0.95rem;
  transition: all 0.25s;
  border: 1px solid transparent;
  text-decoration: none;
}

.nav-links li a:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #FFFFFF;
}

.nav-links li a.active {
  background: rgba(123, 63, 255, 0.25);
  border-color: rgba(64, 232, 255, 0.4);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 0 16px rgba(123, 63, 255, 0.3);
}

.sidebar-user {
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.user-name {
  color: #FFFFFF;
  font-weight: 600;
  font-size: 0.92rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 2. Right Main Content Area */
.main-content {
  margin-left: 260px;
  padding: 24px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 20px;
  box-sizing: border-box;
  width: calc(100% - 260px);
}

/* 3. Top Horizontal Header */
.top-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16px;
  width: 100%;
  box-sizing: border-box;
}

.top-header h2 {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0;
  color: #FFFFFF !important;
}

.header-right-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.header-search-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 50px;
  padding: 8px 18px;
  width: 220px;
}

.header-search-bar input {
  background: none;
  border: none;
  outline: none;
  color: #FFFFFF;
  font-size: 0.88rem;
  width: 100%;
}
.header-search-bar input::placeholder {
  color: #8B9BD1;
}

.header-icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 1.1rem;
  transition: all 0.25s;
}

.header-icon-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--accent);
}

/* 4. 6-Card Responsive Statistics Grid */
.stats-grid-6 {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 20px;
  width: 100%;
}

.stat-card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16px;
  padding: 20px 16px;
  text-align: left;
  transition: all 0.3s;
}

.stat-card:hover {
  transform: translateY(-4px);
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--accent);
  box-shadow: 0 10px 25px rgba(5, 8, 22, 0.6), 0 0 20px rgba(64, 232, 255, 0.25);
}

.stat-value {
  font-size: 1.8rem;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
  margin-bottom: 6px;
}

.stat-label {
  font-size: 0.82rem;
  color: #C8D0E8;
  font-weight: 500;
}

/* 5. 2-Column Workspace Grid */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  width: 100%;
}

.card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16px;
  padding: 24px;
  box-sizing: border-box;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.activity-item:last-child {
  border-bottom: none;
}
.activity-icon {
  font-size: 1.2rem;
}

/* 6. Quick Actions (ONE ROW on Desktop) */
.quick-actions-card {
  width: 100%;
}

.quick-actions-row {
  display: flex;
  gap: 16px;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
}

.btn-quick-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 18px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF !important;
  font-weight: 600;
  font-size: 0.92rem;
  backdrop-filter: blur(12px);
  transition: all 0.3s;
  text-align: center;
  white-space: nowrap;
  text-decoration: none;
}

.btn-quick-action:hover {
  background: rgba(123, 63, 255, 0.25);
  border-color: var(--accent);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(5, 8, 22, 0.5), 0 0 16px rgba(64, 232, 255, 0.3);
}

/* 7. Responsive Media Queries */
@media (max-width: 1200px) {
  .stats-grid-6 {
    grid-template-columns: repeat(3, 1fr);
  }
  .quick-actions-row {
    flex-wrap: wrap;
  }
}

@media (max-width: 768px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }
  .sidebar.open {
    transform: translateX(0);
  }
  .main-content {
    margin-left: 0;
    width: 100%;
    padding: 16px;
  }
  .stats-grid-6 {
    grid-template-columns: repeat(2, 1fr);
  }
  .grid-2 {
    grid-template-columns: 1fr;
  }
}
/* ===== GLOBAL LAYOUT FIX ===== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{
    width:100%;
    min-height:100%;
    overflow-x:hidden;
}

body{
    display:flex;
    flex-direction:column;
    background:#050816;
}

/* Navbar */

.navbar,
header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 40px;
    z-index:9999;
}

/* Hero */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:120px 80px 60px;
    gap:60px;
}

/* Dashboard */

.dashboard{
    display:grid;
    grid-template-columns:260px 1fr;
    min-height:100vh;
}

/* Sidebar */

.sidebar{
    width:260px;
    position:fixed;
    left:0;
    top:72px;
    bottom:0;
    overflow-y:auto;
}

/* Main */

.main-content{
    margin-left:260px;
    margin-top:72px;
    padding:30px;
}

/* Cards */

.stats-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:20px;
}

.card{
    width:100%;
}

/* Two Columns */

.two-column{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

/* Quick Actions */

.quick-actions{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:20px;
}

.quick-actions button,
.quick-actions a{
    width:100%;
}

/* Upload */

.upload-container{
    max-width:1000px;
    margin:auto;
}

.upload-box{
    width:100%;
    min-height:280px;
    display:flex;
    justify-content:center;
    align-items:center;
}

/* Responsive */

@media(max-width:992px){

.dashboard{
grid-template-columns:1fr;
}

.sidebar{
position:relative;
width:100%;
top:0;
}

.main-content{
margin:0;
}

.hero{
flex-direction:column;
text-align:center;
padding:120px 25px;
}

.quick-actions{
grid-template-columns:repeat(2,1fr);
}

.two-column{
grid-template-columns:1fr;
}

}
/* ===== DASHBOARD LAYOUT FIX ===== */

.app-layout{
    display:grid !important;
    grid-template-columns:260px 1fr !important;
    min-height:100vh;
}

.sidebar{
    display:flex !important;
    flex-direction:column;
    width:260px;
    position:sticky;
    top:0;
    height:100vh;
}

.main-content{
    width:100%;
    padding:30px;
    overflow-x:hidden;
}

.stats-grid-6{
    display:grid !important;
    grid-template-columns:repeat(6,minmax(150px,1fr));
    gap:20px;
}

.dashboard-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.quick-actions{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:20px;
}

@media(max-width:1024px){

.app-layout{
grid-template-columns:1fr;
}

.sidebar{
position:relative;
width:100%;
height:auto;
}

.stats-grid-6{
grid-template-columns:repeat(2,1fr);
}

.dashboard-row{
grid-template-columns:1fr;
}

.quick-actions{
grid-template-columns:repeat(2,1fr);
}

}
/* ===== FORCE LAYOUT FIX ===== */

.app-layout{
display:grid !important;
grid-template-columns:260px 1fr !important;
min-height:100vh !important;
}

.sidebar{
position:sticky !important;
top:72px !important;
width:260px !important;
height:calc(100vh - 72px) !important;
display:flex !important;
flex-direction:column !important;
gap:8px !important;
overflow-y:auto !important;
}

.main-content{
margin-left:0 !important;
padding:32px !important;
width:100% !important;
}

.stats-grid,
.dashboard-stats{
display:grid !important;
grid-template-columns:repeat(6,minmax(150px,1fr)) !important;
gap:20px !important;
}

.quick-actions{
display:grid !important;
grid-template-columns:repeat(5,1fr) !important;
gap:20px !important;
}

.quick-actions>*{
width:100%;
}

.content-row{
display:grid !important;
grid-template-columns:1fr 1fr !important;
gap:20px !important;
}

.upload-container,
.notes-container{
max-width:1200px;
margin:auto;
}

@media(max-width:1024px){

.app-layout{
grid-template-columns:1fr !important;
}

.sidebar{
position:relative !important;
width:100% !important;
height:auto !important;
top:0 !important;
}

.stats-grid,
.dashboard-stats{
grid-template-columns:repeat(2,1fr)!important;
}

.quick-actions{
grid-template-columns:repeat(2,1fr)!important;
}

.content-row{
grid-template-columns:1fr!important;
}

}
/* ===== Premium Cards ===== */

.card,
.stat-card{
background:rgba(255,255,255,.06);
backdrop-filter:blur(20px);
border:1px solid rgba(255,255,255,.08);
border-radius:20px;
padding:24px;
transition:.35s ease;
box-shadow:0 10px 30px rgba(0,0,0,.25);
}

.card:hover,
.stat-card:hover{
transform:translateY(-8px);
border-color:#7B3FFF;
box-shadow:0 0 30px rgba(123,63,255,.35);
}

.stat-value{
font-size:34px;
font-weight:800;
color:#fff;
margin-bottom:10px;
}

.stat-label{
font-size:15px;
color:#AEB8D8;
}
/* Upload Page */

.upload-container{

display:flex;

justify-content:center;

align-items:center;

padding:60px 20px;

}

.upload-card{

width:100%;

max-width:750px;

padding:60px;

border-radius:30px;

background:rgba(255,255,255,.06);

backdrop-filter:blur(18px);

border:1px solid rgba(255,255,255,.08);

text-align:center;

}

.upload-icon{

font-size:70px;

margin-bottom:20px;

}

.upload-card h2{

font-size:34px;

color:white;

margin-bottom:15px;

}

.upload-card p{

color:#BFC8EA;

margin-bottom:30px;

line-height:1.8;

}

.upload-btn{

display:inline-flex;

justify-content:center;

align-items:center;

padding:16px 40px;

background:#7B3FFF;

color:white;

border-radius:14px;

cursor:pointer;

transition:.3s;

font-weight:700;

}

.upload-btn:hover{

background:#8F58FF;

transform:translateY(-4px);

}

#notesGrid{

display:grid;

grid-template-columns:repeat(auto-fill,minmax(250px,1fr));

gap:20px;

margin-top:30px;

}

.note-card{

padding:22px;

border-radius:18px;

background:rgba(255,255,255,.05);

transition:.3s;

}

.note-card:hover{

transform:translateY(-6px);

border:1px solid #7B3FFF;

}
/* ===== Chat Page ===== */

.chat-layout{
height:calc(100vh - 80px);
display:flex;
flex-direction:column;
padding:25px;
}

.chat-header{
margin-bottom:20px;
}

.chat-header h2{
font-size:32px;
color:#fff;
}

.chat-header span{
color:#9EA9D7;
}

.chat-messages{
flex:1;
overflow-y:auto;
padding:20px;
border-radius:22px;
background:rgba(255,255,255,.05);
backdrop-filter:blur(15px);
}

.message{
max-width:75%;
padding:18px;
margin-bottom:18px;
border-radius:18px;
line-height:1.7;
}

.user-message{
margin-left:auto;
background:#7B3FFF;
color:#fff;
}

.ai-message{
background:rgba(255,255,255,.08);
color:#fff;
}

.chat-input-box{
display:flex;
gap:15px;
margin-top:20px;
}

.chat-input-box textarea{
flex:1;
height:70px;
border:none;
outline:none;
resize:none;
padding:18px;
border-radius:18px;
background:rgba(255,255,255,.08);
color:#fff;
font-size:15px;
}

.chat-input-box button{
width:150px;
border:none;
border-radius:18px;
background:linear-gradient(135deg,#7B3FFF,#40E8FF);
color:#fff;
font-weight:700;
cursor:pointer;
transition:.3s;
}

.chat-input-box button:hover{
transform:translateY(-4px);
}
/* ===== GLOBAL PREMIUM UI ===== */

:root{
--bg:#050816;
--card:rgba(255,255,255,.06);
--border:rgba(255,255,255,.08);
--text:#fff;
--muted:#AEB8D8;
--primary:#7B3FFF;
--cyan:#40E8FF;
}

body{
background:
radial-gradient(circle at top left,#7B3FFF33,transparent 35%),
radial-gradient(circle at bottom right,#40E8FF22,transparent 35%),
#050816;
font-family:Inter,sans-serif;
color:white;
overflow-x:hidden;
}

.card,
.stat-card,
.upload-card,
.chat-messages{
background:var(--card);
backdrop-filter:blur(18px);
border:1px solid var(--border);
border-radius:22px;
box-shadow:0 10px 40px rgba(0,0,0,.35);
transition:.35s;
}

.card:hover,
.stat-card:hover,
.upload-card:hover{
transform:translateY(-6px);
border-color:var(--primary);
box-shadow:0 0 30px rgba(123,63,255,.35);
}

button,
.btn,
.btn-primary,
.btn-quick-action{
background:linear-gradient(135deg,#7B3FFF,#40E8FF);
border:none;
border-radius:14px;
padding:14px 22px;
color:white;
font-weight:700;
cursor:pointer;
transition:.3s;
}

button:hover,
.btn:hover,
.btn-primary:hover,
.btn-quick-action:hover{
transform:translateY(-4px);
box-shadow:0 0 25px rgba(64,232,255,.45);
}

input,
textarea,
select{
background:rgba(255,255,255,.06);
border:1px solid rgba(255,255,255,.08);
border-radius:14px;
color:white;
padding:14px;
outline:none;
}

h1,h2,h3{
color:white;
}

p,
span,
label{
color:#AEB8D8;
}

.stat-value{
font-size:34px;
font-weight:800;
color:white;
}

.stat-label{
color:#AEB8D8;
}

.reveal{
animation:fadeUp .5s ease;
}

@keyframes fadeUp{
from{
opacity:0;
transform:translateY(25px);
}
to{
opacity:1;
transform:translateY(0);
}
}.app-layout{
display:grid;
grid-template-columns:260px 1fr;
}

.sidebar{
width:260px;
height:100vh;
position:sticky;
top:0;
background:#0B1023;
padding:20px;
display:flex;
flex-direction:column;
justify-content:space-between;
}

.sidebar nav{
display:flex;
flex-direction:column;
gap:12px;
}

.sidebar nav a{
text-decoration:none;
padding:12px 16px;
border-radius:12px;
color:#fff;
}

.sidebar nav a.active,
.sidebar nav a:hover{
background:#7B3FFF;
}

.main-content{
padding:30px;
}